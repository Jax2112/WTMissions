mission_settings{
  player{
    army:i=1
    wing:t="armada_01"
    wing:t="armada_02"
    wing:t="armada_03"
  }

  player_teamB{
    army:i=2
  }

  mission{
    type:t="event"
    level:t="levels/berlin.bin"
    environment:t="Day"
    weather:t="good"
  }
}

imports{}
triggers{
  isCategory:b=yes
  is_enabled:b=yes

  Airfields{
    is_enabled:b=yes
    comments:t=""

    props{
      actionsType:t="PERFORM_ONE_BY_ONE"
      conditionsType:t="ALL"
      enableAfterComplete:b=no
    }

    events{
      initMission{}
    }

    conditions{}
    actions{
      addAirfield{
        runwayStart:t="Airfield Start WP"
        runwayEnd:t="Airfield End WP"
        runwayWidth:r=10
        army:i=1
        spawnPoint:t="area_01"
        spawnPoint:t="area_02"
        spawnPoint:t="area_03"
      }

      missionMarkAsRespawnPoint{
        loc_name:t="Warsaw Pact Spawn"
        radius:r=-1
        target:t="Airfield Start WP"
        team:t="A"
        isAirfield:b=yes

        tags{
          air:b=yes
        }
      }
    }

    else_actions{}
  }
}

mission_objectives{
  isCategory:b=yes
  is_enabled:b=yes
}

