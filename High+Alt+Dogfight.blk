selected_tag:t=""
bin_dump_file:t=""

mission_settings{
  player{
    army:i=1
    wing:t="Player"
  }

  player_teamB{
    army:i=2
  }

  mission{
    type:t="singleMission"
    level:t="levels/air_afghan.bin"
    environment:t="Day"
    weather:t="hazy"
    locName:t="High Alt Dogfight"
    locDesc:t="Defeat F-16 and Mig-29"
  }
}

imports{}
triggers{
  isCategory:b=yes
  is_enabled:b=yes

  Start{
    is_enabled:b=yes
    comments:t=""

    props{
      actionsType:t="PERFORM_ONE_BY_ONE"
      conditionsType:t="ALL"
      enableAfterComplete:b=no
    }

    events{
      initMission{}
    }

    conditions{}
    actions{
      unitPutToSleep{
        target:t="Enemy Mig-29"
      }

      unitAttackTarget{
        playerAttracted:b=no
        object:t="Enemy F-16"
        target:t="Player"
      }
    }

    else_actions{}
  }

  "F-16 Resp"{
    is_enabled:b=yes
    comments:t=""

    props{
      actionsType:t="PERFORM_ONE_BY_ONE"
      conditionsType:t="ALL"
      enableAfterComplete:b=yes
    }

    events{
      periodicEvent{
        time:r=1
      }
    }

    conditions{
      unitWhenKilled{
        target:t="Enemy Mig-29"
      }
    }

    actions{
      unitRespawn{
        delay:r=1
        offset:p3=0, 0, 0
        object:t="Enemy F-16"
        target:t="Enemy Resp"
      }

      unitAttackTarget{
        playerAttracted:b=no
        object:t="Enemy F-16"
        target:t="Player"
      }
    }

    else_actions{}
  }

  "Mig-29 Resp"{
    is_enabled:b=yes
    comments:t=""

    props{
      actionsType:t="PERFORM_ONE_BY_ONE"
      conditionsType:t="ALL"
      enableAfterComplete:b=yes
    }

    events{
      periodicEvent{
        time:r=1
      }
    }

    conditions{
      unitWhenKilled{
        target:t="Enemy F-16"
      }
    }

    actions{
      unitWakeUp{
        target:t="Enemy Mig-29"
      }

      unitRespawn{
        delay:r=1
        offset:p3=0, 0, 0
        object:t="Enemy Mig-29"
        target:t="Enemy Resp"
      }

      unitAttackTarget{
        playerAttracted:b=no
        object:t="Enemy Mig-29"
        target:t="Player"
      }
    }

    else_actions{}
  }

  "Enemies Restore"{
    is_enabled:b=yes
    comments:t=""

    props{
      actionsType:t="PERFORM_ONE_BY_ONE"
      conditionsType:t="ALL"
      enableAfterComplete:b=yes
    }

    events{
      periodicEvent{
        time:r=1
      }
    }

    conditions{}
    actions{
      unitRestore{
        target_marking:i=0
        ressurectIfDead:b=no
        fullRestore:b=no
        target:t="Enemy F-16"
        target:t="Enemy Mig-29"
        ammoRestore:b=yes
      }
    }

    else_actions{}
  }
}

mission_objectives{
  isCategory:b=yes
  is_enabled:b=yes
}

