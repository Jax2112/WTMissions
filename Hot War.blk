imports{}
triggers{
  isCategory:b=yes
  is_enabled:b=yes

  Airfields{
    is_enabled:b=yes
    comments:t=""

    props{
      actionsType:t="PERFORM_ONE_BY_ONE"
      conditionsType:t="ALL"
      enableAfterComplete:b=no
    }

    events{
      initMission{}
    }

    conditions{}
    actions{
      addAirfield{
        runwayStart:t="Airfield Start"
        runwayEnd:t="Airfield End"
        runwayWidth:r=10
        army:i=1
        spawnPoint:t="area_01"
        spawnPoint:t="area_02"
        spawnPoint:t="area_03"
        spawnPoint:t="area_04"
      }

      missionMarkAsRespawnPoint{
        loc_name:t="Warsaw Pact Airfield"
        radius:r=-1
        target:t="Airfield Start"
        isAirfield:b=yes

        tags{
          air:b=yes
        }
      }
    }

    else_actions{}
  }
}

mission_objectives{
  isCategory:b=yes
  is_enabled:b=yes
}

