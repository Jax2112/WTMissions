triggers{
  isCategory:b=yes
  is_enabled:b=yes

  "Starting Spawn"{
    is_enabled:b=yes
    comments:t=""

    props{
      actionsType:t="PERFORM_ONE_BY_ONE"
      conditionsType:t="ALL"
      enableAfterComplete:b=no
