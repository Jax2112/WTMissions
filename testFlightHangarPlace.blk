imports{}
triggers{
  isCategory:b=yes
  is_enabled:b=yes

  "Starting Spawn"{
    is_enabled:b=yes
    comments:t=""

    props{
      actionsType:t="PERFORM_ONE_BY_ONE"
      conditionsType:t="ALL"
      enableAfterComplete:b=no
    }

    events{
      initMission{}
    }

    conditions{}
    actions{
      missionMarkAsRespawnPoint{
        loc_name:t="Axis Spawn"
        radius:r=-1
        target:t="Team 1 Spawn"
        team:t="A"
        showOnMap:b=yes

        tags{
          air:b=yes
          type_bomber:b=yes
          type_fighter:b=yes
          type_assault:b=yes
          type_interceptor:b=yes
          type_aa_fighter:b=yes
          type_light_bomber:b=yes
          type_frontline_bomber:b=yes
          type_longrange_bomber:b=yes
          type_hydroplane:b=yes
          type_strike_ucav:b=yes
          carrier_take_off:b=yes
          airfield_take_off:b=yes
          airfield_take_off_air_rb:b=yes
          vtol_jet:b=yes
          none_can_spawn:b=yes
          human:b=yes
          helicopter:b=yes
          type_attack_helicopter:b=yes
          type_utility_helicopter:b=yes
          tank:b=no
          type_heavy_tank:b=no
          type_medium_tank:b=no
          type_light_tank:b=no
          type_tank_destroyer:b=no
          type_spaa:b=no
          artillery:b=no
          aaa:b=no
          ship:b=no
          boat:b=no
          type_frigate:b=no
          type_destroyer:b=no
          type_light_cruiser:b=no
          type_heavy_cruiser:b=no
          type_battlecruiser:b=no
          type_battleship:b=no
          type_submarine:b=no
          type_human:b=no
          walker:b=no
          country_japan:b=yes
          country_germany:b=yes
          country_usa:b=yes
          country_britain:b=yes
          country_australia:b=yes
          country_ussr:b=yes
        }
      }
    }

    else_actions{}
  }

  "Starting Spawn Allies"{
    is_enabled:b=yes
    comments:t=""

    props{
      actionsType:t="PERFORM_ONE_BY_ONE"
      conditionsType:t="ALL"
      enableAfterComplete:b=no
    }

    events{
      initMission{}
    }

    conditions{}
    actions{
      missionMarkAsRespawnPoint{
        loc_name:t="Allies Spawn"
        radius:r=-1
        target:t="Team 2 Spawn"
        team:t="B"

        tags{
          air:b=yes
          type_bomber:b=yes
          type_assault:b=yes
          tank:b=no
          type_heavy_tank:b=no
          type_medium_tank:b=no
          type_tank_destroyer:b=no
          type_spaa:b=no
          artillery:b=no
          aaa:b=no
          ship:b=no
        }
      }
    }

    else_actions{}
  }
}

