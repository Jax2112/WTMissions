          country_usa:b=yes
          country_britain:b=yes
          country_australia:b=yes
          country_ussr:b=yes
        }
      }
    }

    else_actions{}
  }

  "Starting Spawn Allies"{
    is_enabled:b=yes
    comments:t=""

    props{
      actionsType:t="PERFORM_ONE_BY_ONE"
      conditionsType:t="ALL"
      enableAfterComplete:b=no
    }

    events{
      initMission{}
    }

    conditions{}
    actions{
      missionMarkAsRespawnPoint{
        loc_name:t="Allies Spawn"
        radius:r=-1
        target:t="Team 2 Spawn"
        team:t="B"

        tags{
          air:b=yes
          type_bomber:b=yes
          type_assault:b=yes
          tank:b=no
          type_heavy_tank:b=no
          type_medium_tank:b=no
          type_tank_destroyer:b=no
          type_spaa:b=no
          artillery:b=no
          aaa:b=no
          ship:b=no
        }
      }
    }

    else_actions{}
  }
}

